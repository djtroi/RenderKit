    { "field": "AudioChapters", "target": "Chapters", "valueType": "ChapterList" },
    { "field": "AudioDefaultStream", "target": "Track:a1:flag-default", "valueType": "Boolean" },
    { "field": "AudioDiscNumber", "target": "GlobalTag:DISCNUMBER", "valueType": "UInt32" },
    { "field": "AudioDiscTotal", "target": "GlobalTag:DISCTOTAL", "valueType": "UInt32" },
    { "field": "AudioForcedStream", "target": "Track:a1:flag-forced", "valueType": "Boolean" },
    { "field": "AudioLanguage", "target": "Track:a1:language", "valueType": "Language" },
    { "field": "AudioTitle", "target": "Track:a1:name", "valueType": "String" },
    { "field": "AudioTrackNumber", "target": "GlobalTag:TRACKNUMBER", "valueType": "UInt32" },
    { "field": "AudioTrackTotal", "target": "GlobalTag:TRACKTOTAL", "valueType": "UInt32" },
    { "field": "Chapters", "target": "Chapters", "valueType": "ChapterList" },
    { "field": "Composer", "target": "GlobalTag:COMPOSER", "valueType": "String" },
    { "field": "Conductor", "target": "GlobalTag:CONDUCTOR", "valueType": "String" },
    { "field": "Director", "target": "GlobalTag:DIRECTOR", "valueType": "String" },
