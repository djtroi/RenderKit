    "MkvToolNix": {
      "groups": []
    }
  },
  "writeCapability": {
    "status": "Available",
    "adapter": "MkvToolNix",
    "reason": "The pinned mkvpropedit and mkvextract adapter preserves global tags, targets first-of-type track headers explicitly, and replaces canonical chapter lists atomically."
  },
  "writeFields": [
