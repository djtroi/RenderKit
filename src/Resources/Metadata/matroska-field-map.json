    { "field": "ReleaseDate", "target": "GlobalTag:DATE_RELEASED", "valueType": "DateText" },
    { "field": "StereoMode", "target": "Track:v1:stereo-mode", "valueType": "StereoMode" },
    { "field": "Subtitle", "target": "GlobalTag:SUBTITLE", "valueType": "String" },
    { "field": "Synopsis", "target": "GlobalTag:SYNOPSIS", "valueType": "String" },
    { "field": "VideoDefaultStream", "target": "Track:v1:flag-default", "valueType": "Boolean" },
