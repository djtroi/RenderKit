      "groups": ["ID3v2_4", "ID3v2_3", "ID3v2_2", "ID3v1", "Lyrics3"]
    }
  },
  "writeCapability": {
    "status": "Available",
    "adapter": "TagLibSharp",
    "reason": "The bundled TagLibSharp writer updates ID3v2 frames on an atomic file copy and preserves unrelated frames."
  },
  "writeFields": [
    { "field": "Album", "target": "Album", "valueType": "String" },
    { "field": "AlbumArtist", "target": "AlbumArtists", "valueType": "StringList" },
    { "field": "AlbumSort", "target": "AlbumSort", "valueType": "String" },
