      "fieldType": "String",
      "converter": "String",
      "read": { "ExifTool": { "paths": ["Band"] } },
      "semanticNote": "TPE2/TP2 is interpreted as album artist by the de-facto application convention used by common encoders."
    },
    {
      "field": "AlbumSort",
      "fieldType": "String",
      "converter": "String",
      "read": { "ExifTool": { "paths": ["AlbumSortOrder"] } }
