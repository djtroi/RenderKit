{
  "schemaVersion": "1.0",
  "artifactType": "Id3MetadataMap",
  "profile": "ID3",
  "standard": "ID3 Tagging Standard",
  "standardVersion": "2.4.0",
  "sourceUrl": "https://id3.org/id3v2.4.0-frames",
