  "unmappedFields": [
    {
      "field": "Arranger",
      "reason": "Arranger is role-qualified data inside TIPL/IPLS; it must not be guessed from an unparsed people list."
    },
    {
      "field": "AttachedPictures",
      "reason": "The current ExifTool read does not extract APIC/PIC payloads into RenderKit picture objects."
    },
    {
      "field": "AudioChapters",
      "reason": "ExifTool does not expose ID3 CHAP/CTOC frames as a complete chapter graph."
    },
    {
      "field": "Author",
      "reason": "ID3 has no general author frame whose semantics match the canonical field."
    },
    {
      "field": "Barcode",
      "reason": "Barcode is commonly stored in TXXX and requires descriptor-aware parsing."
    },
    {
      "field": "CatalogNumber",
      "reason": "Catalog number is commonly stored in TXXX and requires descriptor-aware parsing."
    },
    {
      "field": "Chapters",
      "reason": "ExifTool does not expose ID3 CHAP/CTOC frames as a complete chapter graph."
    },
    {
      "field": "CoverArtPath",
      "reason": "Embedded APIC/PIC data has no filesystem path unless it is explicitly extracted."
    },
    {
      "field": "LyricsLanguage",
      "reason": "ExifTool does not expose the USLT/SYLT language as an independent unambiguous value."
    },
    {
      "field": "PodcastShow",
      "reason": "The podcast flag, feed URL and podcast ID do not identify a show title."
    }
  ]
